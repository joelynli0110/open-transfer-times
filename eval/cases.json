      "expect": { "calls": [{ "leg": { "from": "MUC", "via": "DOH", "to": "BKK" } }] }
    },
    {
      "id": "times-muc-transatlantic-en",
      "category": "times",
      "prompt": "New York JFK to Berlin with a stop in Munich. I arrive in Munich at 07:50 and the Berlin flight is at 09:00. Same ticket. Is 70 minutes OK?",
      "expect": { "calls": [{ "leg": { "from": "JFK", "via": "MUC", "to": "BER" } }] }
    },
    {
      "id": "duration-fra-50-zh",
