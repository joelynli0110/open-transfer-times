    {
      "id": "compare-three-durations-zh",
      "category": "compare",
      "prompt": "帮我比较三个选项：法兰克福转 50 分钟、伊斯坦布尔转 3 小时、多哈转 2 小时，柏林飞上海，哪个中转最稳？",
      "expect": {
        "compare": { "options": 3 },
        "calls": [
          { "tool": "compare_connections", "leg": { "via": "FRA", "layover_minutes": 50 } },
          { "tool": "compare_connections", "leg": { "via": "IST", "layover_minutes": 180 } },
          { "tool": "compare_connections", "leg": { "via": "DOH", "layover_minutes": 120 } }
        ],
        "forbid_leg_fields": ["arrival_time", "departure_time"]
      }
    },
    {
      "id": "compare-protection-en",
      "category": "compare",
      "prompt": "Two options Berlin to Shanghai via Istanbul: (A) 4 hours, but self-transfer on two tickets; (B) 3 hours on one ticket. Which is safer?",
      "expect": {
        "compare": { "options": 2 },
        "calls": [
          { "tool": "compare_connections", "leg": { "layover_minutes": 240, "ticket": "separate" } },
          { "tool": "compare_connections", "leg": { "layover_minutes": 180, "ticket": "protected" } }
        ]
      }
    },
    {
      "id": "compare-data-quality-en",
      "category": "compare",
      "prompt": "Berlin to New York, one ticket: 2h in Vienna or 2h in Munich. Which connection is more reliable?",
      "expect": {
        "compare": { "options": 2 },
        "calls": [
          { "tool": "compare_connections", "leg": { "via": "VIE", "layover_minutes": 120 } },
          { "tool": "compare_connections", "leg": { "via": "MUC", "layover_minutes": 120 } }
        ]
      }
    },
    {
      "id": "compare-times-en",
