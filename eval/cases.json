      "expect": { "calls": [{ "leg": { "via": "LHR", "layover_minutes": 70 } }] }
    },
    {
      "id": "scope-doh-gate-zh",
      "category": "fact_scope",
      "prompt": "多哈转机 50 分钟，从柏林去曼谷，联程。登机口什么时候关？来得及吗？",
