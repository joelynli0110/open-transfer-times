{
  "description": "Natural-language questions an agent might get, and what correct tool use and answers look like. Leg expectations are partial matches on check_connection arguments or on any compare_connections option. '*present*' / '*absent*' check that a field is or is not set.",
  "cases": [
    {
      "id": "times-ist-protected-zh",
      "category": "times",
      "prompt": "柏林飞上海，在伊斯坦布尔转机，10:00 到，11:15 起飞，同一张票，时间够吗？",
      "expect": { "calls": [{ "leg": { "from": "BER", "via": "IST", "to": "PVG", "ticket": "protected" } }] }
    },
    {
      "id": "times-ist-protected-en",
      "category": "times",
      "prompt": "Berlin to Shanghai via Istanbul: I land at 10:00 and the next flight leaves at 11:15, both on one ticket. Is that enough time?",
      "expect": { "calls": [{ "leg": { "from": "BER", "via": "IST", "ticket": "protected" } }] }
    },
    {
      "id": "times-lhr-terminals-en",
      "category": "times",
      "prompt": "Flying Berlin–London Heathrow–Shanghai. Arrive LHR Terminal 2 at 14:05, depart Terminal 5 at 15:20, single booking. Will I make it?",
      "expect": { "calls": [{ "leg": { "via": "LHR", "arrival_terminal": "2", "departure_terminal": "5" } }] }
    },
    {
      "id": "times-fra-schengen-zh",
      "category": "times",
