{
  "manifest_version": 3,
  "name": "Connection Quality for Google Flights",
  "version": "0.1.0",
  "description": "See whether an international flight connection is comfortable, tight, or risky before you book.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Connection Quality for Google Flights",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/travel/flights*"],
      "js": [
        "src/models/normalized-itinerary.js",
        "src/data/airport-catalog.js",
        "src/engine/airport-rules.js",
        "src/engine/connection-quality.js",
        "src/adapters/googleFlights/parser.js",
        "src/adapters/googleFlights/index.js",
        "src/adapters/index.js",
        "src/ui/assessment-flow.js",
        "src/analytics.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
