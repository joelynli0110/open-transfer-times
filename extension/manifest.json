{
  "manifest_version": 3,
  "name": "Connection Quality for Google Flights BETA",
  "version": "0.1.0",
  "description": "See whether an international flight connection is comfortable, tight, or risky before you book.",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Connection Quality for Google Flights BETA",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/travel/flights*"],
      "js": [
        "core/itinerary.js",
        "core/airport-catalog.js",
        "core/data/airport-data.generated.js",
        "core/airport-rules.js",
        "core/engine.js",
        "src/adapters/googleFlights/parser.js",
        "src/adapters/googleFlights/index.js",
        "src/adapters/index.js",
        "src/ui/assessment-flow.js",
        "src/analytics.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
